{
    "name": "@condev-monitor/monitor-sdk-browser-utils",
    "version": "1.0.0",
    "main": "build/cjs/index.js",
    "module": "build/esm/index.mjs",
    "types": "build/types/index.d.ts",
    "typesVersions": {
        "*": {
            "performance-runtime": [
                "build/types/performance-runtime.d.ts"
            ],
            "web-vitals-runtime": [
                "build/types/web-vitals-runtime.d.ts"
            ]
        }
    },
    "files": [
        "build"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./build/types/index.d.ts",
                "default": "./build/esm/index.mjs"
            },
            "require": {
                "types": "./build/types/index.d.ts",
                "default": "./build/cjs/index.js"
            }
        },
        "./performance-runtime": {
            "import": {
                "types": "./build/types/performance-runtime.d.ts",
                "default": "./build/esm/performance-runtime.mjs"
            },
            "require": {
                "types": "./build/types/performance-runtime.d.ts",
                "default": "./build/cjs/performance-runtime.js"
            }
        },
        "./web-vitals-runtime": {
            "import": {
                "types": "./build/types/web-vitals-runtime.d.ts",
                "default": "./build/esm/web-vitals-runtime.mjs"
            },
            "require": {
                "types": "./build/types/web-vitals-runtime.d.ts",
                "default": "./build/cjs/web-vitals-runtime.js"
            }
        }
    },
    "scripts": {
        "build:watch": "pnpm build:watch:transpile & pnpm build:watch:types",
        "build:watch:transpile": "tsup --watch",
        "build:watch:types": "tsc -p tsconfig.types.json --watch",
        "build": "pnpm clean && pnpm build:transpile && pnpm build:types",
        "build:transpile": "tsup",
        "build:types": "tsc -p tsconfig.types.json",
        "clean": "rimraf build",
        "test": "pnpm --filter @condev-monitor/monitor-sdk-browser exec jest --runInBand --config ../../packages/browser-utils/jest.config.cjs",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [],
    "author": "",
    "license": "",
    "description": "",
    "dependencies": {
        "@condev-monitor/monitor-sdk-core": "workspace:*"
    }
}
