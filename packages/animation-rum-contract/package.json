{
    "name": "@condev-monitor/animation-rum-contract",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Dependency-free normalized wire contracts for Condev Animation RUM",
    "main": "build/cjs/index.cjs",
    "module": "build/esm/index.js",
    "types": "build/types/index.d.ts",
    "typesVersions": {
        "*": {
            "testing": [
                "build/types/testing.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "import": {
                "types": "./build/types/index.d.ts",
                "default": "./build/esm/index.js"
            },
            "require": {
                "types": "./build/types/index.d.ts",
                "default": "./build/cjs/index.cjs"
            }
        },
        "./testing": {
            "import": {
                "types": "./build/types/testing.d.ts",
                "default": "./build/esm/testing.js"
            },
            "require": {
                "types": "./build/types/testing.d.ts",
                "default": "./build/cjs/testing.cjs"
            }
        }
    },
    "files": [
        "build",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf build",
        "build": "pnpm clean && pnpm build:transpile && pnpm build:types",
        "build:transpile": "tsup",
        "build:types": "tsc -p tsconfig.types.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "pnpm build && node --test test/*.test.mjs"
    },
    "license": "Apache-2.0"
}
