{
    "name": "@condev-monitor/react",
    "version": "0.1.0",
    "main": "build/cjs/index.js",
    "module": "build/esm/index.mjs",
    "types": "build/types/index.d.ts",
    "files": [
        "build"
    ],
    "sideEffects": false,
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./build/types/index.d.ts",
                "default": "./build/esm/index.mjs"
            },
            "require": {
                "types": "./build/types/index.d.ts",
                "default": "./build/cjs/index.js"
            }
        },
        "./animation": {
            "import": {
                "types": "./build/types/animation.d.ts",
                "default": "./build/esm/animation.mjs"
            },
            "require": {
                "types": "./build/types/animation.d.ts",
                "default": "./build/cjs/animation.js"
            }
        },
        "./animation/r3f": {
            "import": {
                "types": "./build/types/animation-r3f.d.ts",
                "default": "./build/esm/animation-r3f.mjs"
            },
            "require": {
                "types": "./build/types/animation-r3f.d.ts",
                "default": "./build/cjs/animation-r3f.js"
            }
        }
    },
    "scripts": {
        "clean": "rimraf build",
        "build": "pnpm clean && pnpm build:transpile && pnpm build:types",
        "build:transpile": "tsup",
        "build:types": "tsc -p tsconfig.types.json",
        "test": "pnpm build && node --test test/*.test.mjs"
    },
    "dependencies": {
        "@condev-monitor/monitor-sdk-animation-renderer": "workspace:*",
        "@condev-monitor/monitor-sdk-browser": "workspace:*",
        "@condev-monitor/monitor-sdk-core": "workspace:*"
    },
    "peerDependencies": {
        "@react-three/fiber": ">=8.0.0 <10.0.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "peerDependenciesMeta": {
        "@react-three/fiber": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0"
    }
}
