{
    "name": "@condev-monitor/solid",
    "version": "0.1.0",
    "main": "build/cjs/index.js",
    "module": "build/esm/index.mjs",
    "types": "build/types/index.d.ts",
    "files": [
        "build"
    ],
    "sideEffects": false,
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./build/types/index.d.ts",
                "default": "./build/esm/index.mjs"
            },
            "require": {
                "types": "./build/types/index.d.ts",
                "default": "./build/cjs/index.js"
            }
        },
        "./animation": {
            "import": {
                "types": "./build/types/animation.d.ts",
                "default": "./build/esm/animation.mjs"
            },
            "require": {
                "types": "./build/types/animation.d.ts",
                "default": "./build/cjs/animation.js"
            }
        }
    },
    "scripts": {
        "clean": "rimraf build",
        "build": "pnpm clean && pnpm build:transpile && pnpm build:types",
        "build:transpile": "tsup",
        "build:types": "tsc -p tsconfig.types.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "pnpm build && node --test test/*.test.mjs"
    },
    "dependencies": {
        "@condev-monitor/monitor-sdk-browser": "workspace:*"
    },
    "peerDependencies": {
        "solid-js": "^1.9.10"
    },
    "devDependencies": {
        "solid-js": "^1.9.10"
    }
}
