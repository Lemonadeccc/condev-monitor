{
    "name": "@condev-monitor/monitor-sdk-animation-renderer",
    "version": "0.1.0",
    "description": "Optional renderer instrumentation for Condev Monitor animation performance evidence",
    "main": "build/cjs/index.js",
    "module": "build/esm/index.mjs",
    "types": "build/types/index.d.ts",
    "files": [
        "build",
        "README.md"
    ],
    "sideEffects": false,
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./build/types/index.d.ts",
                "default": "./build/esm/index.mjs"
            },
            "require": {
                "types": "./build/types/index.d.ts",
                "default": "./build/cjs/index.js"
            }
        }
    },
    "scripts": {
        "clean": "rimraf build",
        "build": "pnpm clean && pnpm build:transpile && pnpm build:types",
        "build:transpile": "tsup",
        "build:types": "tsc -p tsconfig.types.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "pnpm --filter @condev-monitor/monitor-sdk-animation build && pnpm build && node --test test/*.test.mjs"
    },
    "keywords": [
        "animation",
        "performance",
        "webgl",
        "gpu",
        "timer-query"
    ],
    "license": "Apache-2.0",
    "devDependencies": {
        "@condev-monitor/monitor-sdk-animation": "workspace:*"
    }
}
