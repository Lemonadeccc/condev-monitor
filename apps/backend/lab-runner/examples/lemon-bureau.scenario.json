{
    "schemaVersion": 1,
    "name": "lemon-bureau-home-motion",
    "url": "http://127.0.0.1:43101/",
    "routeKey": "lemon-bureau.home",
    "environment": "development",
    "viewport": {
        "width": 1440,
        "height": 900,
        "deviceScaleFactor": 1
    },
    "reducedMotion": "no-preference",
    "cacheMode": "warm",
    "warmupRuns": 1,
    "measuredRuns": 3,
    "measurementContract": {
        "contractVersion": 2,
        "expectedHz": 60,
        "targetFrameMs": 16.666667,
        "source": "explicit",
        "confidence": "explicit",
        "budgetRef": {
            "catalogVersion": 1,
            "budgetId": "condev.animation.default",
            "budgetVersion": 2
        },
        "metricCatalogVersion": 3
    },
    "actions": [
        {
            "kind": "wait",
            "label": "preloader-complete",
            "actionId": "preloader-complete",
            "subject": { "scope": "page", "role": "preloader", "surface": "dom" },
            "trigger": { "source": "scenario" },
            "technologies": [
                { "axis": "ui-framework", "technologyKey": "vanilla" },
                { "axis": "motion-engine", "technologyKey": "gsap" }
            ],
            "durationMs": 100,
            "expect": [
                {
                    "kind": "element-state",
                    "selector": ".preloader",
                    "state": "hidden",
                    "timeoutMs": 8000
                }
            ]
        },
        {
            "kind": "pointer-path",
            "label": "hero-pointer-follow",
            "actionId": "hero-pointer-follow",
            "subject": { "scope": "page", "role": "hero-pointer-follow", "surface": "unknown" },
            "trigger": { "source": "scenario" },
            "technologies": [
                { "axis": "ui-framework", "technologyKey": "vanilla" },
                { "axis": "renderer", "technologyKey": "three" },
                { "axis": "graphics-api", "technologyKey": "webgl" }
            ],
            "durationMs": 1600,
            "selector": ".hero",
            "points": [
                { "xRatio": 0.2, "yRatio": 0.25 },
                { "xRatio": 0.75, "yRatio": 0.3 },
                { "xRatio": 0.65, "yRatio": 0.75 },
                { "xRatio": 0.3, "yRatio": 0.6 }
            ],
            "expect": [
                {
                    "kind": "registered-outcome",
                    "outcomeKey": "lemon.hero.pointer-settled",
                    "state": "completed",
                    "timeoutMs": 3000
                }
            ]
        },
        {
            "kind": "click",
            "label": "navigation-open",
            "actionId": "navigation-open",
            "subject": { "scope": "page", "role": "navigation", "surface": "dom" },
            "trigger": { "source": "scenario" },
            "technologies": [
                { "axis": "ui-framework", "technologyKey": "vanilla" },
                { "axis": "motion-engine", "technologyKey": "gsap" }
            ],
            "selector": ".nav-toggler",
            "expect": [
                {
                    "kind": "attribute-token",
                    "selector": ".nav-toggler",
                    "attribute": "aria-expanded",
                    "value": "true",
                    "timeoutMs": 4000
                }
            ]
        },
        {
            "kind": "click",
            "label": "navigation-close",
            "actionId": "navigation-close",
            "subject": { "scope": "page", "role": "navigation", "surface": "dom" },
            "trigger": { "source": "scenario" },
            "technologies": [
                { "axis": "ui-framework", "technologyKey": "vanilla" },
                { "axis": "motion-engine", "technologyKey": "gsap" }
            ],
            "selector": ".nav-toggler",
            "expect": [
                {
                    "kind": "attribute-token",
                    "selector": ".nav-toggler",
                    "attribute": "aria-expanded",
                    "value": "false",
                    "timeoutMs": 4000
                }
            ]
        },
        {
            "kind": "press",
            "label": "keyboard-scheduling",
            "actionId": "keyboard-scheduling",
            "subject": { "scope": "page", "role": "keyboard-scheduling", "surface": "unknown" },
            "trigger": { "source": "scenario" },
            "technologies": [{ "axis": "ui-framework", "technologyKey": "vanilla" }],
            "key": "Escape"
        },
        {
            "kind": "resize",
            "label": "desktop-resize",
            "actionId": "desktop-resize",
            "subject": { "scope": "page", "role": "resize", "surface": "unknown" },
            "trigger": { "source": "scenario" },
            "technologies": [
                { "axis": "ui-framework", "technologyKey": "vanilla" },
                { "axis": "renderer", "technologyKey": "three" }
            ],
            "width": 1180,
            "height": 760
        }
    ],
    "trace": {
        "enabled": true,
        "screenshots": false,
        "maxDurationMs": 30000
    },
    "lighthouse": {
        "enabled": true,
        "categories": ["performance", "accessibility", "best-practices"],
        "formFactor": "desktop"
    }
}
